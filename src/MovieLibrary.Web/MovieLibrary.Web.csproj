<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- The first Core type the browser consumes: MovieRecord, CatalogMeta and ConfidenceBand. Core carries
         ZERO package references, so this adds only its own IL to the payload and no transitive dependency.
         The enrich project is never referenced from here, because it reads TMDB_TOKEN and that code would
         then be in the browser payload. SourceContractTests pins that by scanning this file for its name,
         which is why the name is not spelled out here: that scan is a plain substring match and a comment
         mentioning it fails just as a reference would. This is the only reference that belongs. -->
    <ProjectReference Include="..\MovieLibrary.Core\MovieLibrary.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MovieLibrary.Web.Tests" />
    <!-- The browser gate asserts the SAME string constants the pages render - Movies.CouldNotLoad,
         Movies.LoadingVisible, Movies.LoadingSpoken - rather than its own literals, so a reworded
         sentence cannot leave a green gate waiting on text the app no longer shows. It also reads
         Announcer.SettleDelay to size its waits. -->
    <InternalsVisibleTo Include="MovieLibrary.Web.A11y" />
  </ItemGroup>

</Project>
