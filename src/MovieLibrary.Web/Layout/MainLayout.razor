@inherits LayoutComponentBase

<a class="skip-link visually-hidden-focusable" href="#main-content" @onclick="SkipToMain" @onclick:preventDefault>Skip to main content</a>

<div class="page">
    <header>
        <NavMenu />
    </header>

    <main id="main-content" tabindex="-1" @ref="mainElement">
        <div class="content">@Body</div>
    </main>
</div>

@code {
    private ElementReference mainElement;

    // href="#main-content" resolves against <base href="/">, so Blazor turns the click into an in-app
    // navigation to "/" and the query string is lost. Keep the real href for semantics and assistive
    // technology, stop Blazor intercepting the click, and focus the element directly instead.
    private async Task SkipToMain() => await mainElement.FocusAsync();
}
