@implements IDisposable
@inject NavigationManager Navigation

<nav aria-label="Main">
    <a class="brand" href="">Film and TV library</a>

    <button type="button" class="nav-toggle"
            aria-expanded="@(collapsed ? "false" : "true")"
            aria-controls="nav-links"
            @onclick="Toggle" @ref="toggleButton">
        <svg class="nav-toggle-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Menu</span>
    </button>

    <ul class="nav-links @(collapsed ? "collapsed" : null)" id="nav-links" role="list"
        @onfocusin="() => listHasFocus = true" @onfocusout="() => listHasFocus = false">
        @foreach (var item in items)
        {
            var current = IsCurrent(item);
            <li><a class="nav-link @(current ? "active" : null)" href="@item.Href" aria-current="@(current ? "page" : null)">@item.Label</a></li>
        }
    </ul>
</nav>

@code {
    // One entry per nav link. Paths lists every base-relative address that shows that link's page, because
    // NavLink can only match a single href and "/" and "/movies" are the same page. Part B adds a link by
    // adding an entry here, and a second address for an existing page by adding to its Paths.
    private sealed record NavItem(string Label, string Href, string[] Paths);

    private static readonly NavItem[] items =
    {
        new("Films", "movies", new[] { "", "movies" }),
    };

    private bool collapsed = true;
    private bool listHasFocus;
    private bool restoreFocus;
    private string previousPath = string.Empty;
    private ElementReference toggleButton;

    // aria-expanded is rendered from the strings above, never from a bool: a bool attribute value is
    // present-and-empty when true and omitted when false, which ARIA reads as undefined either way.
    private void Toggle() => collapsed = !collapsed;

    protected override void OnInitialized()
    {
        previousPath = CurrentPath();
        Navigation.LocationChanged += OnLocationChanged;
    }

    // Following a link closes the drawer. Left open it would hold the focus context inside a list the user
    // has finished with, and on a phone it covers the page they just navigated to.
    //
    // Closing is display:none, which takes the focused link out of the tab order and drops focus to <body>.
    // When the target is a different page, FocusOnNavigate moves focus to that page's h1. When it is the page
    // already showing, FocusOnNavigate does not fire at all, so put focus back on the Menu button instead.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = CurrentPath();
        if (!collapsed && listHasFocus && IsSamePage(previousPath, path)) restoreFocus = true;
        previousPath = path;

        collapsed = true;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restoreFocus) return;

        restoreFocus = false;
        await toggleButton.FocusAsync();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private bool IsCurrent(NavItem item) => Array.IndexOf(item.Paths, CurrentPath()) >= 0;

    private static bool IsSamePage(string from, string to) =>
        items.Any(i => Array.IndexOf(i.Paths, from) >= 0 && Array.IndexOf(i.Paths, to) >= 0);

    /// <summary>The address relative to the base, without query string, fragment or trailing slash.</summary>
    private string CurrentPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = path.IndexOfAny(new[] { '?', '#' });
        if (end >= 0) path = path[..end];
        return path.TrimEnd('/');
    }
}
