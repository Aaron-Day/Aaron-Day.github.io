<nav aria-label="Main">
    <a class="brand" href="">Film and TV library</a>

    <button type="button" class="nav-toggle"
            aria-expanded="@(collapsed ? "false" : "true")"
            aria-controls="nav-links"
            @onclick="Toggle">
        <svg class="nav-toggle-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Menu</span>
    </button>

    <ul class="nav-links @(collapsed ? "collapsed" : null)" id="nav-links" role="list">
        <li><NavLink class="nav-link" href="movies" Match="NavLinkMatch.All">Films</NavLink></li>
    </ul>
</nav>

@code {
    private bool collapsed = true;

    // aria-expanded is rendered from the strings above, never from a bool: a bool attribute value is
    // present-and-empty when true and omitted when false, which ARIA reads as undefined either way.
    private void Toggle() => collapsed = !collapsed;
}
