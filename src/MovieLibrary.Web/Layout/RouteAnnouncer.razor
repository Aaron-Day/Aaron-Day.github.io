@implements IDisposable
@inject NavigationManager Navigation
@inject Announcer Announcer

@* Renders nothing. It exists to listen, and to say the page's name when the PAGE changes.

   Independent of NavMenu on purpose. Both subscribe to LocationChanged, but they share no state: NavMenu owns the
   drawer and the focus guard, this owns one string. Sharing a subscription would couple the nav to announcements it
   has no use for.

   What orders the route name against the focus move is not the settle delay and not the handler order. It is the
   single-threaded event loop: the name is written from a timer callback, and a timer callback cannot run until the
   whole synchronous navigation chain -- both LocationChanged handlers, the router's render, FocusOnNavigate's h1
   focus and NavMenu's Menu-button focus -- has finished. The focus move therefore lands first however the
   subscriptions are ordered. (They are ordered Router, then this, then NavMenu, so this handler already runs after
   the router has rendered and asked for focus.) The delay's job is the clear-then-set gap plus some margin; it is
   not load-bearing for ordering, and shortening it would not reorder anything.

   Silent on the first load, which the browser announces itself. Silent for a query string or fragment that
   changes alone: filters live there, so otherwise every keystroke would announce a page change. *@

@code {
    private string lastPath = string.Empty;

    // The page name for each path that serves a page. Typed by hand, and pinned two ways: a test walks every @page
    // route and requires the announcement to equal that page's h1, so a new route without an entry fails the build
    // rather than being announced as "Page not found" on a page that exists. The names match the h1 and the nav.
    private static string PageNameFor(string path) => path.ToLowerInvariant() switch
    {
        "" or "movies" => "Films",
#if DEBUG
        // The local record editor. Debug only, because Release does not serve this address at all and
        // announcing a name for an address the router answers with its not-found page would be a lie. The
        // string is RecordEditor.Heading, character for character.
        "editor" => "Record editor",
#endif
        _ => "Page not found",   // the router renders its not-found page for every address that matches no route
    };

    protected override void OnInitialized()
    {
        lastPath = PagePath.Of(Navigation, Navigation.Uri);    // first load: record, do not announce
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = PagePath.Of(Navigation, e.Location);
        if (string.Equals(path, lastPath, StringComparison.OrdinalIgnoreCase)) return;   // a filter changed, not the page

        lastPath = path;
        Announcer.Route(PageNameFor(path));
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
