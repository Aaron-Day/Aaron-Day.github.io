@page "/editor"
@implements IDisposable
@using System.Globalization
@using MovieLibrary.Core.Parsing
@using MovieLibrary.Core.Store
@inject EditorCatalogue Catalogue
@inject LocalDirectory Folder
@inject IStatusRegion Region
@inject IJSRuntime Js

<PageTitle>@Heading - Film and TV library</PageTitle>

<h1 tabindex="-1">@Heading</h1>

@* ONE stable container, as Movies.razor has it, and never swapped for a different node between states:
   replacing the node would destroy the one a screen reader's virtual cursor may be sitting on. It holds one
   sentence of prose and, where a retry applies, one button. It carries tabindex of minus one so a failure can
   take focus, which puts the message out of SC 4.1.3's scope instead of relying on it being honoured, and it
   is styled by the site's own stylesheet, so this page adds none. No live region of any kind in here. *@
<div class="catalog-state" tabindex="-1" @ref="container">
    <p>@Sentence</p>

    @if (ShowTryAgain)
    {
        @* aria-disabled and never the disabled attribute: disabling the focused element blurs it and drops focus
           to the body. The click still arrives and is ignored in code. *@
        <button type="button" class="try-again" aria-disabled="@(loading ? "true" : null)" @onclick="TryAgain">Try again</button>
    }
</div>

@if (Local && state is { Rows.Count: > 0 } ready)
{
    <Worklist Rows="ready.Rows" OpenKey="@openKey" Opened="OnOpened" Closed="OnClosed">
        @* THE PAGE OWNS THE DRAFT AND THE SAVE, and the form owns only what is on screen. The worklist closes
           the open row on every debounced query change, so a draft held inside the form would be destroyed
           150 ms after one character reached the search box; and the grant, the file and the store draft are
           one page's state, not one row's. The form is keyed on the row so two rows never share one instance:
           a reference capture is applied on the render that creates an element, and a shared instance would
           carry the previous row's captures into this one. *@
        <RowContent Context="row">
            <RecordForm @ref="form" @key="row.Movie.K" Row="row" Draft="DraftFor(row)"
                        Editable="ready.Editable" ApiSupported="ready.ApiSupported"
                        FolderName="@ready.FolderName" Store="ready.Store" Saving="saving"
                        Outcome="@outcome" Save="SaveAsync" ChooseFolder="GrantAsync" />
        </RowContent>
    </Worklist>
}

@code {
    // Outside every branch, and focusable, because App.razor's FocusOnNavigate selector is "#app h1" and
    // ElementReference.FocusAsync() does not add tabindex itself -- it fails silently on an element that cannot
    // take focus. The heading text is also the name the route announcer's table has to carry, character for
    // character, so these two strings are one string in two files and changing one means changing both.
    internal const string Heading = "Record editor";

    internal const string NotLocalSentence =
        "The record editor runs on your own machine only. This copy of the site was not served by the "
        + "development server, so there is nothing here to edit.";

    internal const string LoadingSentence = "Loading the records…";

    internal const string CatalogueFailedSentence =
        "The published catalogue could not be loaded, so there are no records to edit. "
        + "Check that the site has data, then try again.";

    // Says that nothing was READ, and stops there. The script answers null both for "the file is not there" and
    // for "I could not read it" and cannot tell them apart, so a stronger claim -- "there is no store yet" --
    // would be a guess presented as fact. Saving is safe either way, because the write side refuses to
    // overwrite a file it could not read.
    internal const string NoStoreReadSentence =
        "No record store was read, so no existing corrections are shown. Try again once the repository folder "
        + "is available to this page.";

    internal const string SyntheticSentence =
        "This catalogue was generated for testing and its TMDB ids are invented, so a correction made against "
        + "it would mean nothing. Rebuild the catalogue from the real sheet to edit.";

    // The store is sparse by design: an entry that corrects nothing is a line in a committed file that says
    // nothing, and the reader refuses one. Said rather than written, because the script copies the current file
    // to .bak on every write, so a save of identical bytes spends the one step back he has and returns nothing,
    // leaving the backup a copy of the state he is already in. It covers both ways of arriving here -- a record
    // with no corrections at all, and a correction he opened and did not change -- so it claims only that the
    // file already agrees. No .bak promise: under StoreReading.NotRead there may be none to point at (M8).
    internal const string NothingToSaveSentence =
        "Nothing was written, because the record store already says exactly what this save would have written. "
        + "The version before your last save is untouched.";

    /// <summary>The same outcome where no store file was READ, which can claim very much less (m2).</summary>
    /// <remarks>
    /// <para>What this save compared itself against is the draft THIS PAGE holds. Under
    /// <see cref="StoreReading.Read"/> that draft came from the file, so <see cref="NothingToSaveSentence"/>
    /// may speak about the file; under <see cref="StoreReading.NotRead"/> it began as an EMPTY store -- the
    /// script answers null both for a file that is not there and for one it could not read, and cannot tell
    /// them apart across the interop boundary -- so nothing here knows what the file holds, and the sentence
    /// above would be making the claim <see cref="NoStoreReadSentence"/> deliberately refuses to make, about a
    /// previous version that on a fresh clone does not exist.</para>
    /// <para><b>And it may not deny the corrections or the folder either, which is what it used to do.</b>
    /// Nothing in a successful save changes <see cref="EditorState.Store"/> -- <c>Rebadge</c> returns the draft
    /// and the rows -- so a clone whose store file does not exist yet reaches this sentence on the second press
    /// of a save that has just succeeded: the corrections it said were absent are in the draft it compared
    /// itself against, and the folder it told him to wait for had just taken a write. What is certain is what
    /// is said: this save would have produced the store this page is already holding, and that draft, not the
    /// file, is what it was measured against.</para>
    /// </remarks>
    internal const string NothingToSaveUnreadSentence =
        "Nothing was written, because this save would have produced exactly the record store this page is "
        + "already holding. That is what it was compared against: this page's own draft, not the file, which "
        + "was not read.";

    // A54's named failure mode: a prompt he dismissed that says nothing leaves the page looking unchanged.
    internal const string NoFolderChosenSentence =
        "No folder was chosen, so nothing can be saved yet. Press the folder button again and choose the "
        + "folder this repository is checked out in.";

    /// <summary>What the download route can claim, which is less than the folder route: it is a different file.</summary>
    internal static string Downloaded(string name) =>
        $"{name} was handed to the browser's downloads. Nothing was written to the repository folder, so move "
        + "the downloaded file into the repository by hand before the next build.";

    /// <summary>What the folder route can claim, which is three different things.</summary>
    /// <param name="saved">
    /// The record the file now holds at this row's position, or null for a removal. The same expression
    /// <c>Reseat</c> rebuilds the draft from, so the sentence and the form answer from one fact.
    /// </param>
    internal static string Written(string name, string folder, bool removed, RecordOverride? saved)
    {
        if (removed)
            return $"Saved. The correction was removed from {name} in {folder}, and the next build will "
                   + "publish this record as the sheet has it.";

        // THE DISTINCTION THIS SENTENCE USED TO MISS, which EditorCatalogue.IsCorrected states one file away
        // and the worklist badge has always obeyed. Candidates are ids he SAW and did not choose between, so
        // MoviePipeline asserts no id for them AND makes no search, because a search returns the same ones --
        // and that arm comes BEFORE the cache, so a record matched today publishes with no id at all after
        // this save. "The next build will apply it" was false for the one save that leaves the decision open,
        // and the owner repeated it back as his account of what he had just done.
        //
        // KEYED ON THE CANDIDATES AND NOT ON A MISSING ID. A record correcting only a runtime or a title
        // asserts no id either, and the build applies those, so the id is the wrong question. Candidates may
        // sit beside those corrections, which is why this claims nothing beyond the match.
        if (saved?.Candidates is { Length: > 0 } ids)
            return $"Saved. {name} in {folder} now holds {Spell(ids)} under \"Override candidate ids\" and "
                   + "no TMDB id, so this save decides no match: the next build will publish this record "
                   + "with no TMDB match, and it will not search for one, because a search would only find "
                   + "the ids you have already seen. The row keeps the badge it has and still needs a "
                   + "decision -- choose one of the \"Candidate TMDB ids\" options and save again, or enter "
                   + "the id under \"Override TMDB id\" instead.";

        return $"Saved. {name} in {folder} holds this correction, and the next build will apply it.";
    }

    /// <summary>Ids as the file spells them: invariant, so a grouping separator never reaches the sentence.</summary>
    private static string Spell(int[] ids) =>
        string.Join(", ", ids.Select(id => id.ToString(CultureInfo.InvariantCulture)));

    [Inject] private IWebAssemblyHostEnvironment Environment { get; set; } = default!;

    // The second guard, independent of the first. The first is that MovieLibrary.Web references this project in
    // Debug alone, so a Release payload has no editor assembly and no route to reach. This one catches the case
    // where a Debug build is served from somewhere that is not the dev server: a standalone WebAssembly app
    // takes its environment from the dev server's own header, and a static host sends none, so the default is
    // Production.
    private bool Local => Environment.IsDevelopment();

    private ElementReference container;
    private EditorState? state;
    private bool focusPending;
    private string? openKey;
    private bool loading;
    private bool disposed;

    /// <summary>
    /// M11. One draft per published key, held by the PAGE and outliving the row: Worklist.ApplyAsync closes the
    /// open row on every debounced query change, so one character in the search box would otherwise destroy
    /// what he had typed 150 ms later. Reopening a row restores it, which is also A31's "pre-fill, never
    /// re-ask" for the unsaved case.
    /// </summary>
    private readonly Dictionary<string, RecordDraft> drafts = new(StringComparer.Ordinal);

    private RecordForm? form;
    private bool saving;
    private string outcome = "";
    private bool reportPending;
    private bool problemPending;
    private bool grantPending;

    /// <summary>The state's own sentence, one at a time: the most important thing the owner has to be told.</summary>
    private string Sentence
    {
        get
        {
            if (!Local) return NotLocalSentence;
            if (state is null) return LoadingSentence;
            if (state.Catalogue == CatalogueState.Failed) return CatalogueFailedSentence;
            if (state.Store == StoreReading.Refused)
                return $"The record store could not be read, so nothing can be edited: {state.StoreProblem} "
                       + "Fix the file by hand, then try again.";
            if (state.Synthetic) return SyntheticSentence;
            if (state.Unplaceable.Count > 0) return UnplaceableSentence(state);
            if (state.Store == StoreReading.NotRead) return NoStoreReadSentence;

            return $"The library holds {state.Rows.Count:N0} records.";
        }
    }

    // A correction he made that nothing published matches is not shown in the list, and silence about it would
    // lose it. The keys are the entries' own, so he can find them in the file.
    private static string UnplaceableSentence(EditorState s) =>
        (s.Unplaceable.Count == 1
            ? "1 correction in the record store matches no published record, so it is not shown in the list: "
            : $"{s.Unplaceable.Count:N0} corrections in the record store match no published record, so they are not shown in the list: ")
        + string.Join(", ", s.Unplaceable.Select(f => f.IdentityKey)) + ".";

    /// <summary>The button stays while a load is in flight: removing it would drop focus to the body.</summary>
    private bool ShowTryAgain => Local && (loading || state is not null && (
        state.Catalogue == CatalogueState.Failed || state.Store != StoreReading.Read));

    protected override async Task OnInitializedAsync()
    {
        if (!Local) return;

        loading = state is null;
        state = await Catalogue.LoadAsync();
        loading = false;
        focusPending = NeedsAttention;
    }

    private async Task TryAgain()
    {
        if (loading) return;

        loading = true;
        state = null;
        openKey = null;

        // An explicit re-read is a deliberate ask for what the FILE says, so the drafts go with it: a draft is
        // pre-filled from the entry it was built against, and keeping one across a re-read would show the
        // previous file's values over the new file's entry -- including after he fixed that file by hand, which
        // is the one instruction the refused-store sentence gives him. Unsaved typing in a row is lost, which
        // is the cost of asking; the row is closed by the same press, so nothing on screen changes under him.
        drafts.Clear();

        var next = await Catalogue.LoadAsync();
        if (disposed) return;

        state = next;
        loading = false;
        focusPending = NeedsAttention;
    }

    /// <summary>A state the owner must be told about, as opposed to one that is simply how the library is.</summary>
    private bool NeedsAttention => state is not null
        && (state.Catalogue == CatalogueState.Failed || state.Store != StoreReading.Read
            || state.Unplaceable.Count > 0 || state.Synthetic);

    /// <remarks>
    /// The focus move is how a problem is reported: a focused container's text IS the sentence, so nothing else
    /// is raised and nothing is announced twice. It moves only if nobody has moved focus themselves -- the
    /// helper in index.html answers that, because C# cannot read the active element -- and swallows the ways
    /// interop can fail, since an escape would reveal the host page's error bar, an assertive source of its own.
    /// Nothing auto-dismisses and nothing auto-retries: a message that cleared itself is a time limit on reading it.
    /// </remarks>
    /// <remarks>
    /// <para><b>Every report in here is raised from a render and never from the handler that caused it</b>
    /// (A50), so the text the handler wrote has reached the DOM before anything points a user at it.</para>
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;

        if (focusPending)
        {
            focusPending = false;

            try
            {
                await Js.InvokeAsync<bool>("movieLibrary.focusIfUnmoved", container, FocusKeepers);
            }
            catch (Exception ex) when (ex is JSException or TaskCanceledException or ObjectDisposedException)
            {
            }
        }

        if (disposed) return;

        // A43: the first field that is wrong takes focus and its own error is read as its description. No
        // summary at the top: for a ten-field form inside row 200 of 285 that forces a second journey down.
        if (problemPending)
        {
            problemPending = false;
            if (form is { } onProblem) await onProblem.FocusFirstProblemAsync();
        }

        if (disposed) return;

        // A54. Back to the button that opened the prompt, whichever way it ended. Nothing is announced: that
        // button's description IS the granted state, so the arrival states it and states it once.
        if (grantPending)
        {
            grantPending = false;
            if (form is { } onGrant) await onGrant.FocusFolderAsync();
        }

        if (disposed) return;

        // A45, A48 and A49. The focus move IS the report, success and failure alike, and it lands on the
        // FORM's own container: the load-state container above renders above the worklist, so focusing that
        // from row 200 would throw him to the top of the page, and the one polite region on this page belongs
        // to the worklist, where the debounced count would overwrite whatever was put in it. The assertive
        // fallback is raised ONLY where the move did not happen -- raising both speaks one sentence twice,
        // once as the contents of what focus landed on and again when the region interrupts with the same
        // words. Focus moves are interop and interop can fail, which is the only reason that branch exists.
        if (reportPending)
        {
            reportPending = false;

            var moved = form is { } onReport && await onReport.FocusOutcomeAsync();

            if (!moved && outcome.Length > 0)
            {
                Region.Alert(outcome);
                alerted = true;
            }
        }
    }

    private static readonly string[] FocusKeepers = ["#main-content", "#app h1"];

    // The report belongs to the save it came from, so it does not survive the row. The DRAFT does (M11).
    //
    // AND THE REGION IS CLEARED WITH IT (m7). Emptying `outcome` takes the sentence off the SCREEN; a sentence
    // raised assertively is not on the screen at all, it is standing in a region that outlives the row, this
    // page and the navigation, so a failure left there was readable in browse mode with nothing on screen to
    // match it. ClearAlert only writes where this page has something standing, so a row opened and closed
    // without a save touches nothing.
    private void OnOpened(string key)
    {
        openKey = key;
        outcome = "";
        ClearAlert();
    }

    private void OnClosed()
    {
        openKey = null;
        outcome = "";
        ClearAlert();

        // A component reference is assigned on the render that creates the component and is NOT cleared when
        // the component goes, so a stale form would take a focus move meant for the next one -- onto an
        // element that is no longer in the document, which drops focus to the body.
        form = null;
    }

    /// <summary>One draft per published key, made on first sight of the row and kept afterwards (M11).</summary>
    private RecordDraft DraftFor(WorklistRow row)
    {
        if (drafts.TryGetValue(row.Movie.K, out var held)) return held;

        var made = RecordDraft.For(row.Movie, SavedIn(row.Entry, row.Position), EchoedMinutes(row.Entry));
        drafts[row.Movie.K] = made;
        return made;
    }

    /// <summary>
    /// The record this row is corrected by, which is the one at the row's POSITION and never the entry's
    /// first: one Apple row can publish four films, and pre-filling from the wrong record shows him somebody
    /// else's values.
    /// </summary>
    private static RecordOverride? SavedIn(FilmEntry? entry, int position) =>
        entry is not null && position >= 1 && position <= entry.Records.Count
            ? entry.Records[position - 1]
            : null;

    /// <summary>The row's own runtime in minutes as the entry's echo states it, or null when it cannot say.</summary>
    /// <remarks>
    /// <para><b>Why the echo, and why a single-record entry only.</b> <see cref="EchoOf"/> writes it from the
    /// minutes the row published when the entry was created, and <see cref="Place"/> never rewrites an
    /// existing entry's, so it still states the ROW's own runtime one build after a correction moved what the
    /// catalogue publishes -- which is exactly when <c>movie.Rt</c> stops being able to tell a correction from
    /// the value every save supplies. For an entry of SEVERAL records the echo is the Apple row's one runtime
    /// and describes none of its films, so it says nothing about any one record and is not used: the published
    /// minutes are the right reference there, and an entry with siblings is never one the removal arm can
    /// delete anyway.</para>
    /// <para>That the echo is PARSED is not new -- m3 conceded it, because RecordLink.PublishedKeyOf reads it
    /// for a record stating no runtime of its own -- and this is not matching either. It decides whether a
    /// runtime in the form is a correction, and an echo that will not parse falls back to the published
    /// minutes, which is where this page started.</para>
    /// </remarks>
    private static int? EchoedMinutes(FilmEntry? entry) =>
        entry is { Records.Count: 1 } && RuntimeParser.TryFilmMinutes(entry.Sheet.Runtime, out var minutes)
            ? minutes
            : null;

    /// <summary>
    /// Rebuilds the open row's draft from the record that was just written, so the form shows what the FILE
    /// says rather than what was typed at it.
    /// </summary>
    /// <remarks>
    /// A31's shortlist half needs this: the candidate chooser offers <c>RecordDraft.Offered</c>, which is read
    /// from the saved record when the draft is built, so candidates he entered and saved were offered back as
    /// values only after a reload -- until then the ids he had just saved were text he would have to retype,
    /// which is the one thing SC 3.3.7 asks nobody to do. It is also the honest answer for every other field:
    /// what the save wrote is what the row now holds, trimmed and parsed as the file has it.
    /// </remarks>
    private void Reseat(WorklistRow row, FilmEntry? entry) =>
        drafts[row.Movie.K] = RecordDraft.For(row.Movie, SavedIn(entry, row.Position), EchoedMinutes(entry));

    private void Report(string text)
    {
        ClearAlert();
        outcome = text;
        reportPending = true;
    }

    /// <summary>
    /// Whether a sentence of this page's is standing in the assertive region, so that it can be taken down.
    /// </summary>
    /// <remarks>
    /// A47. Delivered text never expires: the region is a scoped singleton behind a layout that survives
    /// navigation, so a handled save failure stays readable in browse mode for the rest of the session -- on
    /// the Films page, beside a successful retry, and after this page has gone. Worklist clears its own polite
    /// statement on dispose and Movies.razor clears both of its own; this is the same obligation.
    /// </remarks>
    private bool alerted;

    /// <remarks>
    /// A cancellation and not a message: it takes effect at once and speaks nothing. It is owed because
    /// DELIVERED TEXT NEVER EXPIRES -- the region's own API note is explicit about it: the region is a scoped
    /// singleton behind a layout that survives navigation, so whoever puts a statement up takes it down when
    /// it stops being true. Tracked rather than cleared blindly, so a page with nothing standing never writes
    /// to a region it does not own anything in.
    /// <para><b>The mechanism an earlier version of this remark gave was wrong, and it is corrected rather
    /// than deleted, because it is the kind of claim that gets copied.</b> It said that a repeated identical
    /// sentence would reach the DOM as no change at all, and that this is why the same failure twice would
    /// otherwise be spoken once. It would not be: the region empties itself inside its own lock before EVERY
    /// delivery, and the layout re-arms the settle delay on the render that carries that clear, so a repeat
    /// goes text, empty, text either way. Raising the clear from the HANDLER that writes the new outcome,
    /// rather than beside the next statement in OnAfterRenderAsync, is still right -- it keeps the take-down
    /// and the statement that replaces it two observable mutations instead of one frame's worth, and a second
    /// assertive sentence raised while the first is still pending JOINS it rather than replacing it, so the
    /// take-down has to land before the next one is raised.</para>
    /// </remarks>
    private void ClearAlert()
    {
        if (!alerted) return;

        alerted = false;
        Region.Alert("");
    }

    /// <remarks>
    /// <para><b>The exception arms are two facts, not one</b> (M10). A <see cref="RecordStoreException"/> is a
    /// store the NEXT BUILD would reject, caught before anything is written and reported in the reader's own
    /// words with one framing clause in front: ToValidatedJson passes "the record store about to be saved" as
    /// the thing being read, so the message would otherwise be spoken starting mid-sentence. The others are a
    /// write that did not happen, and their message is LocalDirectory's own -- there are three causes behind
    /// it (no folder granted in this browser, a lapsed permission, an existing file that could not be copied
    /// and therefore deliberately not overwritten) and a sentence of mine would have to guess which.</para>
    /// <para>Anything uncaught reaches the host page's error bar, which carries an assertive role of its own:
    /// two spoken statements for one event.</para>
    /// </remarks>
    private async Task SaveAsync()
    {
        if (saving || state is not { } s || !s.Editable || openKey is not { } key) return;

        var row = s.Rows.FirstOrDefault(r => string.Equals(r.Movie.K, key, StringComparison.Ordinal));
        if (row is null) return;

        var draft = DraftFor(row);

        // Reported from the render, with the focus move, and never written over the file.
        if (draft.AnyProblem)
        {
            problemPending = true;
            return;
        }

        saving = true;
        outcome = "";

        try
        {
            var (next, entry, removed, problem) = Place(s.Draft, row, draft);

            // A correction that cannot be represented: reported and nothing written. Place's own remarks say
            // why the binder abstaining upstream is not enough to make this safe.
            if (problem is not null)
            {
                Report(problem);
                return;
            }

            // THE CHECK BEFORE THE SAVE, and it throws before anything leaves the page: the file is read back
            // through the same reader the next build will use.
            var json = next.ToValidatedJson();
            var name = RecordStoreReader.DefaultFileName;

            // Nothing changed, so nothing is written: the script copies the current file to .bak on every
            // write, and a save of identical bytes would spend A58's one step back and give nothing for it.
            // ON THE BYTES, NOT THE REFERENCE: StoreDraft.With allocates a new draft, Place a new list and a
            // new entry, so a reference check is false for a record he opened and did not change -- which is
            // the ordinary way to reach this, and the way that costs him the save before it.
            if (string.Equals(json, RecordStoreReader.Write(s.Draft.Store), StringComparison.Ordinal))
            {
                // What this may claim depends on whether a store was read at all: the comparison above is
                // against what was READ, which under NotRead is an empty store and not the file (m2).
                Report(s.Store == StoreReading.Read ? NothingToSaveSentence : NothingToSaveUnreadSentence);
                return;
            }

            if (s.ApiSupported) await Folder.WriteTextAsync(name, json);
            else await Folder.DownloadAsync(name, json);

            if (disposed) return;

            state = Rebadge(s, next, row, entry);
            Reseat(row, entry);
            Report(s.ApiSupported
                ? Written(name, s.FolderName ?? "the chosen folder", removed, SavedIn(entry, row.Position))
                : Downloaded(name));
        }
        catch (RecordStoreException ex)
        {
            Report($"Nothing was saved. {ex.Message}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException
                                      or TaskCanceledException or ObjectDisposedException)
        {
            Report(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>
    /// Puts the form's record where it belongs: AT THE ROW'S POSITION, inside the entry that is already there.
    /// </summary>
    /// <remarks>
    /// An entry's Records is a list and its Note is the owner's own words, so an entry built from the row and
    /// the form alone writes one record where there were four: three siblings silently deleted, the note
    /// nulled, and a file that still validates and publishes one film where four were (C6).
    /// </remarks>
    private static (StoreDraft Next, FilmEntry? Entry, bool Removed, string? Problem) Place(
        StoreDraft draft, WorklistRow row, RecordDraft form)
    {
        var existing = draft.Film(row.IdentityKey);

        // ABSTAINING UPSTREAM DOES NOT MAKE THIS SAVE SAFE, which is why the guard is here and not in the
        // binder. A row nothing could bind still carries a key -- the one it recomputes for ITSELF -- and
        // position 1, and a bundle record whose runtime is the Apple row's own publishes a record that
        // recomputes the ENTRY's own key. So both rows of such a bundle arrive here carrying that key at
        // position 1, under a blank form with no badge, and the first save replaced Records[0] of an entry it
        // was never bound to and promised the next build would apply it. Where the row carries no entry and
        // one is already filed under its key, no position is provable and the correction is not
        // representable: it is REPORTED and nothing is written, the same answer the runtime-only-into-a-bundle
        // case gets -- in the reader's own words there, in ours here, because no reader is reached.
        //
        // AND IT IS THE FIRST THING THIS METHOD DOES, which is load-bearing and now has a test of its own
        // (ABareSaveOnARowNothingBoundIsRefusedRatherThanRemovingTheEntryUnderItsKey). Below the removal arm
        // it is unreachable for the save that needs it most: a bare Save on an unbound row's blank form
        // overrides nothing, so the arm would reach draft.Without and delete the entry under that key
        // outright, note and all, and report a removal success.
        if (row.Entry is null && existing is not null)
            return (draft, null, false, NotRepresentableSentence(row.IdentityKey, existing.Records.Count > 1));

        // A record that overrides nothing goes, rather than being written as a line that says nothing -- and
        // the judgment ignores the runtime THE SAVE writes, which goes on every record whether or not it was
        // corrected (M3). A runtime he chose himself is a correction like any other and keeps the entry.
        // ONLY where the entry holds that one record. An entry with siblings cannot lose one without
        // renumbering the others -- an unmatched record's published key carries its position -- so there the
        // runtime-only record is placed and the reader refuses it in its own words, which is the honest
        // answer: a correction that cannot be represented is reported and not guessed at.
        if (form.OverridesNothing && (existing is null || existing.Records.Count <= 1))
            return (draft.Without(row.IdentityKey), null, true, null);

        var record = form.Build(row.Movie.Rt);
        var records = existing?.Records.ToList() ?? [];

        if (records.Count == 0) records.Add(record);
        else if (row.Position >= 1 && row.Position <= records.Count) records[row.Position - 1] = record;
        else records.Add(record);

        // The echo is written for a NEW entry only. An existing entry's echo and note are the file's own, and
        // the echo is what a human reads to find the entry: rewriting it from the published record would
        // quietly replace a hand-corrected title with the one the sheet still has.
        var entry = existing is null
            ? new FilmEntry { IdentityKey = row.IdentityKey, Sheet = EchoOf(row.Movie), Records = records }
            : existing with { Records = records };

        return (draft.With(entry), entry, false, null);
    }

    /// <summary>
    /// What a save is told when the row's own key already belongs to an entry nothing bound this row to. Says
    /// what the owner can do about it, because there is nothing this page can do about it.
    /// </summary>
    /// <remarks>
    /// Two ways in, and they need different advice, which one sentence used to give both of them wrongly.
    /// <paramref name="expanded"/> tells them apart. An entry of several records covers several films of one
    /// sheet row and nothing published says which of them this film is: runtimes that differ are what lets the
    /// next load tell those records apart, and a rebuild re-aligns the published keys so the first pass finds
    /// them outright. An entry of ONE record has already had that record claimed by another published row, so
    /// there is nothing to tell apart inside it and a rebuild leaves the same two rows computing the same key
    /// -- the advice there is to make the two rows differ. Either way a position would have to be guessed, and
    /// a guessed position writes a correction over another film.
    /// </remarks>
    internal static string NotRepresentableSentence(string identityKey, bool expanded) =>
        $"Nothing was written. The record store already holds the entry {identityKey}, which is the key this "
        + "record computes for itself, and nothing in the published catalogue says which of that entry's "
        + "records this one is -- so saving here would write over a correction that belongs to another film. "
        + (expanded
            ? $"Open {RecordStoreReader.DefaultFileName} and give that entry's records runtimes that tell them "
              + "apart, or rebuild the catalogue so this correction can be found again."
            : "That entry holds one record and another published record already holds it: as far as the "
              + "sheet's title, runtime and directors can tell, this is the same film twice, so a rebuild "
              + "makes the same collision again. Give the two rows something that tells them apart -- the "
              + "edition in the title, or the runtime each copy really has -- and rebuild.");

    /// <summary>The sheet's three columns as a human reads them, for finding this entry in the file by eye.</summary>
    /// <remarks>
    /// <b>The seconds are not recoverable and this is not the sheet's own text.</b> MovieRecord.Rt is whole
    /// minutes, because RuntimeParser.FilmMinutes truncates, so the sheet's 2:06:53 is published as 126 and
    /// written back here as the canonical 2:06:00.
    /// <para><b>And it is parsed, which an earlier version of this remark denied.</b> SheetEcho is documented
    /// as never consumed for MATCHING -- the identity key does that -- but RecordLink.PublishedKeyOf reads
    /// entry.Sheet.Runtime through RuntimeParser.TryFilmMinutes whenever a record states no runtime of its own,
    /// which is legal in a hand-written single-record entry and is the path pass 1 depends on for one. What
    /// holds of an entry THIS editor writes is narrower, and is why the canonical form costs nothing: every
    /// record it writes carries its own runtime (M3), so that fallback is never reached for one of ours. The
    /// title and the directors ARE exact -- the pipeline publishes the sheet's own.</para>
    /// <para>And <see cref="EchoedMinutes"/> reads these minutes back, which is the one account of the row's
    /// own runtime that survives a build publishing a correction to it. Whatever is written here is what that
    /// judgment will measure against, so the canonical form is not decoration.</para>
    /// </remarks>
    private static SheetEcho EchoOf(MovieRecord movie) => new(
        movie.T,
        string.Create(CultureInfo.InvariantCulture, $"{movie.Rt / 60}:{movie.Rt % 60:00}:00"),
        string.Join(" & ", movie.Dir));

    /// <summary>
    /// C5. The saved row is re-badged IN PLACE and does not leave the filtered list: a row that vanished on
    /// save would move 284 others under a hand already reaching for the next one, and the open panel's focus
    /// would have nowhere to go. The band is untouched, because the band is what the PUBLISHED record says and
    /// nothing published changes until the next build; what changes is the editor's own knowledge of it.
    /// </summary>
    private static EditorState Rebadge(EditorState s, StoreDraft next, WorklistRow row, FilmEntry? entry) =>
        s with
        {
            Draft = next,
            Rows = s.Rows
                .Select(r => ReferenceEquals(r, row)
                    ? r with { Entry = entry, Corrected = EditorCatalogue.IsCorrected(entry, r.Position) }
                    : r)
                .ToList(),
        };

    /// <remarks>
    /// A52: the prompt is a button activation and never a load, a focus or a change event. The grant's own
    /// answer is what updates the folder, and the store is deliberately NOT re-read here: the page already
    /// carries a Try again control for that, and re-reading would also overwrite what he has typed into the
    /// open form with what the file says.
    /// </remarks>
    private async Task GrantAsync()
    {
        if (saving || state is not { } s || !s.ApiSupported) return;

        try
        {
            var chosen = await Folder.GrantAsync();
            if (disposed) return;

            if (chosen is null) outcome = NoFolderChosenSentence;
            else
            {
                state = s with { FolderName = chosen };
                outcome = "";
            }

            // A54, and only on the arms where the prompt actually ended: the button's own description IS the
            // granted state, so the arrival states it and states it once.
            grantPending = true;
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or ObjectDisposedException)
        {
            // The prompt did not end -- it never opened. So there is nothing for an arrival on the folder
            // button to say: its description is the grant paragraph, which still says exactly what it said
            // before the press. Reported the way a save failure is reported instead -- focus to the outcome
            // container, whose text IS the sentence, and the assertive channel only where that move did not
            // happen -- because a failure that is visible and spoken by nothing is the silent class A57
            // forbids. The message is the script's own: a sentence of mine would be guessing which it was.
            Report(ex.Message);
        }
    }

    public void Dispose()
    {
        disposed = true;
        ClearAlert();
    }
}
