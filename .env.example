# ---------------------------------------------------------------
# MovieLibrary — local secrets for running MovieLibrary.Enrich
#
# This file is gitignored. Never commit it, and never paste its
# contents into a chat or an issue.
#
# In CI the same value arrives from the GitHub Actions *repository*
# secret named TMDB_TOKEN (Settings -> Secrets and variables ->
# Actions). Codespaces secrets are a separate store and are NOT
# visible to workflow runs.
# ---------------------------------------------------------------

# Paste ONE credential from https://www.themoviedb.org/settings/api
#
#   API Read Access Token (v4)  <- preferred
#       long string beginning "eyJ"
#       sent as:  Authorization: Bearer <token>
#       Keeps the credential out of URLs, so it cannot leak into
#       server logs, proxy logs or printed error messages.
#
#   API Key (v3)
#       32-character hex string
#       sent as:  ?api_key=<key>
#
# The enrich tool detects which kind it was handed, so either works.

TMDB_TOKEN=

# ---------------------------------------------------------------
# Optional overrides — defaults are compiled in, uncomment to change
# ---------------------------------------------------------------

# SHEET_ID=1gkDwOi5-Gvm48WkYz8noYUb5i6QjfQSDLpEDYV5QlHk

# How many TMDB requests one run may spend. 0 means no limit.
#
# Every local run defaults to 40, which is deliberate: enough to
# prove the whole pipeline, small enough to be unremarkable against
# TMDB's rate limits. A run that reaches it stops cleanly, keeps
# every response it paid for in enrich-cache/, writes a catalogue
# marked INCOMPLETE for local preview, and exits 0 WITHOUT being
# deployable. The whole library is roughly 9,500 requests, so
# seeding it from empty needs 0 here (or max-requests: 0 on a
# manual workflow dispatch) and about 40 to 70 minutes.
#
# MAX_REQUESTS_PER_RUN=0

# Re-fetch everything, ignoring the committed match cache.
#
# This REQUIRES MAX_REQUESTS_PER_RUN=0, and the tool refuses the
# pair before fetching anything: a forced run never loads the
# committed cache index and then saves a whole new one, so one that
# stopped on a budget would leave the index holding only the handful
# of entries it managed to re-fetch, and every other film and series
# would cost a full lookup again.
#
# true and false are accepted in any case; anything else is an error
# rather than a guess. Left out, it is false.
#
# FORCE_REFRESH=false
