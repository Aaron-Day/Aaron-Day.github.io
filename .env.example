# ---------------------------------------------------------------
# MovieLibrary — local secrets for running MovieLibrary.Enrich
#
# This file is gitignored. Never commit it, and never paste its
# contents into a chat or an issue.
#
# In CI the same value arrives from the GitHub Actions *repository*
# secret named TMDB_TOKEN (Settings -> Secrets and variables ->
# Actions). Codespaces secrets are a separate store and are NOT
# visible to workflow runs.
# ---------------------------------------------------------------

# Paste ONE credential from https://www.themoviedb.org/settings/api
#
#   API Read Access Token (v4)  <- preferred
#       long string beginning "eyJ"
#       sent as:  Authorization: Bearer <token>
#       Keeps the credential out of URLs, so it cannot leak into
#       server logs, proxy logs or printed error messages.
#
#   API Key (v3)
#       32-character hex string
#       sent as:  ?api_key=<key>
#
# The enrich tool detects which kind it was handed, so either works.

TMDB_TOKEN=

# ---------------------------------------------------------------
# Optional overrides — defaults are compiled in, uncomment to change
# ---------------------------------------------------------------

# SHEET_ID=1gkDwOi5-Gvm48WkYz8noYUb5i6QjfQSDLpEDYV5QlHk
# FORCE_REFRESH=false
